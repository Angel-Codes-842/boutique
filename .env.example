POSTGRES_USER=boutique
POSTGRES_DB=boutique
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-random-secret

# Facturación electrónica (SIFEN / FACTPY). Dejar false hasta tener credenciales.
FACTPY_ENABLED=false
FACTPY_API_URL=https://api.factpy.com
FACTPY_RECORD_ID=
FACTPY_ENVIRONMENT=test
FACTPY_TIMEOUT_MS=10000

# Referencia para Vercel + Supabase (NO pegar secretos reales en el repo;
# cargarlos en Vercel → Project Settings → Environment Variables).
# Usar el session pooler (5432) también en runtime: la app hace transacciones interactivas.
# DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres?connection_limit=1
# DIRECT_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
# SESSION_SECRET=random-de-al-menos-32-caracteres
# TZ=America/Asuncion
